do $$
begin
  perform vault.create_secret('s3kr3t_k3y', 'a_name', 'this is the foo secret key');
end
$$;
-- can select from masking view with custom key
SELECT decrypted_secret, description 
FROM vault.decrypted_secrets WHERE name = 'a_name';
 decrypted_secret |        description         
------------------+----------------------------
 s3kr3t_k3y       | this is the foo secret key
(1 row)

-- can update name, secret and description
select vault.update_secret(
    (select id from vault.secrets where name = 'a_name'), new_name:='a_new_name',
    new_secret:='new_s3kr3t_k3y', new_description:='this is the bar key');
 update_secret 
---------------
 
(1 row)

TRUNCATE vault.secrets;
set role bob;
do $$
begin
  perform vault.create_secret ('foo', 'bar', 'baz');
end
$$;
-- bob can query a secret
SELECT (decrypted_secret COLLATE "default"), name, description FROM vault.decrypted_secrets
WHERE name = 'bar';
 decrypted_secret | name | description 
------------------+------+-------------
 foo              | bar  | baz
(1 row)

-- bob can update a secret
select vault.update_secret(
(select id from vault.secrets where name = 'bar'),
'fooz',
'barz',
'bazz');
 update_secret 
---------------
 
(1 row)

-- bob can query an updated secret
SELECT (decrypted_secret COLLATE "default"), name, description
FROM vault.decrypted_secrets;
 decrypted_secret | name | description 
------------------+------+-------------
 fooz             | barz | bazz
(1 row)

reset role;
truncate vault.secrets;
do $$
begin
  perform vault.create_secret(
    new_secret := '',
    new_name := 'empty_secret'
  );
end
$$;
-- secret can be an empty string
select decrypted_secret collate "default"
from vault.decrypted_secrets
where name = 'empty_secret';
 decrypted_secret 
------------------
 
(1 row)

-- Validate version of vault installed (no missed upgrade SQL scripts)
SELECT extversion FROM pg_extension where extname = 'supabase_vault';
 extversion 
------------
 0.3.2
(1 row)

-- Validate that each security definer function explicitly specifies pg_temp and 
-- pg_catalog and that pg_catalog comes before pg_temp
WITH security_definer_fn_settings AS (
       SELECT n.nspname AS schema_name
            , p.proname AS function_name
            , string_to_array(unnest(p.proconfig)
                            , '=') AS configuration_setting
       FROM pg_proc AS p
            INNER JOIN pg_namespace AS n ON p.pronamespace = n.oid
       WHERE prosecdef = TRUE
     )
   , security_definer_fn_search_paths AS (
       SELECT s.schema_name
            , s.function_name
            , string_to_array(btrim((s.configuration_setting)[2]
                                  , '"')
                            , ',') AS search_path_ary
       FROM security_definer_fn_settings AS s
       WHERE (s.configuration_setting)[1] = 'search_path'
     )
   , security_definer_fn_search_paths_trimmed AS (
       SELECT s.schema_name
            , s.function_name
            , ARRAY(SELECT pg_catalog.btrim(x)
                    FROM unnest(s.search_path_ary) WITH ORDINALITY AS t (x, i)
                    ORDER BY i) AS search_path_ary
       FROM security_definer_fn_search_paths AS s
     )
  SELECT s.schema_name
       , s.function_name
       , s.search_path_ary
  FROM security_definer_fn_search_paths_trimmed AS s
  WHERE array_position(s.search_path_ary, 'pg_temp') < array_position(s.search_path_ary, 'pg_catalog')
    AND array_position(s.search_path_ary, 'pg_temp') IS NOT NULL
    AND array_position(s.search_path_ary, 'pg_catalog') IS NOT NULL;
 schema_name | function_name | search_path_ary 
-------------+---------------+-----------------
(0 rows)

